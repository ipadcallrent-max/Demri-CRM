# Projet Supabase (région UE). Paramètres > API dans le tableau de bord Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : serveur uniquement (invitations). Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique du site, pour les liens des e-mails d'invitation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
